/* Style lab v2: structural variants */

/* ---------- shared ---------- */
.logo {
    padding: 1 0 0 1;
    color: $primary;
    text-style: bold;
    height: auto;
}

.strip {
    background: $primary;
    color: $background;
    text-style: bold;
    padding: 0 1;
    height: 1;
}

.panel {
    border: thick $boost;
    padding: 0 1;
}

.panel:focus-within {
    border: thick $primary;
}

ListView {
    border: none;
}

ListItem {
    padding: 0 2;
    height: 1;
}

ListItem.--highlight {
    background: $primary;
    color: $background;
    text-style: bold;
}

/* ---------- 1. Sidebar ---------- */
SidebarScreen {
    layout: horizontal;
}

#side {
    width: 26;
    height: 100%;
    background: $panel;
    border-right: thick $secondary;
}

#nav {
    height: 1fr;
}

#main {
    width: 1fr;
    layout: vertical;
}

#main #chat {
    height: 1fr;
}

/* ---------- 2. TopTabs ---------- */
TopTabsScreen {
    layout: vertical;
}

#tabs {
    height: 1;
    background: $panel;
}

.tab {
    padding: 0 1;
    color: $text-muted;
}

.tab.active {
    background: $primary;
    color: $background;
    text-style: bold;
}

TopTabsScreen #chat {
    height: 1fr;
    border: none;
    padding: 1 2;
}

#input-row {
    height: auto;
    padding: 0 1;
}

/* ---------- 3. FullChat ---------- */
FullChatScreen {
    layout: vertical;
}

FullChatScreen #chat {
    height: 1fr;
    padding: 1 2;
}

#menu-overlay {
    width: 100%;
    height: 100%;
    background: $background 60%;
}

#menu-box {
    width: 40;
    height: auto;
    background: $panel;
    border: thick $primary;
    padding: 1 2;
}

#menu-list {
    height: auto;
    margin-top: 1;
}

/* ---------- 4. Tiling ---------- */
TilingScreen {
    layout: vertical;
}

#tile-main {
    height: 100%;
}

#tile-left {
    width: 2fr;
    layout: vertical;
}

#tile-left #chat {
    height: 1fr;
}

#tile-right {
    width: 1fr;
    layout: vertical;
    border-left: thick $secondary;
}

#status-pane {
    height: 8;
    border: none;
    border-bottom: thick $secondary;
}

#logs-pane {
    height: 1fr;
    border: none;
}

/* ---------- 5. GameMenu ---------- */
GameMenuScreen {
    background: $background;
}

#game-menu {
    width: 44;
    height: auto;
    align: center middle;
}

.big-logo {
    color: $primary;
    text-style: bold;
    content-align: center middle;
}

.dither {
    color: $secondary;
    content-align: center middle;
    margin: 1 0;
}

#game-nav {
    height: auto;
    background: $background;
    margin: 1 4;
}

#game-nav ListItem {
    content-align: center middle;
}

.hint {
    color: $text-muted;
    content-align: center middle;
    margin-top: 1;
}

/* fake input/button mocks (visual only, so digit keys stay free) */
.fake-input {
    height: 3;
    background: $boost;
    color: $text-muted;
    padding: 1 2;
    content-align: left middle;
}

.fake-button {
    height: 3;
    background: $primary;
    color: $background;
    text-style: bold;
    padding: 1 2;
    content-align: center middle;
}
