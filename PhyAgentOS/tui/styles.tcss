/* PhyAgentOS TUI — Morandi palette, refined minimal style
   高级感 = 克制：细圆角边框、发丝分割线、留白、扁平按钮、柔和选中 */

Screen {
    background: $background;
}

AppHeader {
    height: 1;
    padding: 0 1;
    background: $panel;
}

.header-title {
    width: 1fr;
    color: $accent;
    text-style: bold;
}

.header-right {
    width: auto;
    color: $text-muted;
    content-align: right middle;
}

Footer {
    background: $panel;
    color: $text-muted;
}

ChatScreen, ProvidersScreen, ChannelsScreen, SettingsScreen {
    layout: vertical;
}

/* ---------- Tiling chat screen ---------- */
#tile-main {
    width: 100%;
    height: 1fr;
    layout: horizontal;
}

#tile-left {
    width: 2fr;
    height: 100%;
    layout: vertical;
    padding: 0 1;
}

#tile-right {
    width: 1fr;
    height: 100%;
    layout: vertical;
    border-left: solid $boost;
}

/* Section titles: accent bar + bold caps + hairline */
.section-title {
    height: 2;
    layout: horizontal;
    margin-top: 1;
    border-bottom: solid $boost;
}

.section-title .title-bar {
    width: 1;
    height: 1;
    background: $primary;
}

.section-title .title-text {
    height: 1;
    padding: 0 1;
    color: $primary;
    text-style: bold;
}

ChatView {
    height: 1fr;
    border: round $boost;
    padding: 0 1;
    margin: 1 0 0 0;
}

ChatView:focus-within {
    border: round $primary;
}

ChatInput {
    height: auto;
    max-height: 10;
    border: round $boost;
    padding: 0 1;
    margin: 1 0 1 0;
}

ChatInput:focus-within {
    border: round $primary;
}

StatusPane {
    height: auto;
    padding: 1 2;
    color: $text;
    border-bottom: solid $boost;
}

LogView {
    height: 1fr;
    border: none;
    padding: 0 1;
    background: $surface;
    color: $text-muted;
}

/* ---------- Menu overlay ---------- */
MenuOverlay {
    width: 100%;
    height: 100%;
    background: $background 75%;
    align: center middle;
}

#menu-box {
    width: 36;
    height: auto;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

.overlay-title {
    color: $primary;
    text-style: bold;
    padding-bottom: 1;
}

#menu-list {
    height: auto;
    background: $surface;
    border: none;
}

#menu-list:focus {
    border: none;
}

#menu-list ListItem {
    padding: 0 1;
    height: 1;
}

#menu-list ListItem.--highlight {
    background: $boost;
    color: $text;
    text-style: bold;
}

/* ---------- Sub screens ---------- */
#providers-main, #channels-main, #settings-wrap {
    width: 100%;
    height: 1fr;
    layout: vertical;
    padding: 0 1;
}

#providers-body {
    layout: horizontal;
    height: 1fr;
    margin-top: 1;
}

.hint {
    color: $text-muted;
    padding: 0 1;
}

/* Providers Screen */
#provider-list-container {
    width: 32;
    border-right: solid $boost;
}

#provider-form-container {
    width: 1fr;
    padding: 0 2;
}

#provider-form {
    height: auto;
}

/* Settings Screen */
#settings-main {
    height: 1fr;
    margin-top: 1;
}

#settings-footer {
    height: auto;
    padding: 1 0 1 0;
}

.settings-group {
    height: auto;
    border: round $boost;
    padding: 1 2;
    margin-bottom: 1;
}

.settings-group-title {
    text-style: bold;
    color: $accent;
    padding-bottom: 1;
}

/* ---------- Common widgets ---------- */
DataTable {
    height: auto;
}

DataTable .datatable--header {
    background: $surface;
    color: $text-muted;
    text-style: bold;
}

DataTable .datatable--cursor {
    background: $boost;
    color: $text;
}

Input {
    border: none;
    border-bottom: solid $boost;
    background: $surface;
}

Input:focus {
    border: none;
    border-bottom: solid $primary;
}

Select {
    border: none;
    background: $surface;
    width: 1fr;
}

Select:focus {
    border: none;
}

Select > SelectCurrent {
    border: none;
    border-bottom: solid $boost;
    background: $surface;
}

Select:focus > SelectCurrent {
    border-bottom: solid $primary;
}

Select > SelectOverlay {
    background: $surface;
    border: round $boost;
}

Select > SelectOverlay > .select--option-highlighted,
Select > SelectOverlay > *:hover {
    background: $boost;
    color: $text;
}

.form-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.form-label {
    width: 20;
    content-align: right middle;
    padding-right: 1;
    color: $text-muted;
}

.form-input {
    width: 1fr;
}

Button {
    margin: 0 1;
    border: none;
    background: $boost;
    color: $text;
    text-style: bold;
}

Button:hover, Button:focus {
    border: none;
    background: $primary;
    color: $background;
}

Button.-primary {
    border: none;
    background: $primary;
    color: $background;
    text-style: bold;
}

/* ---------- MOSS Mission HUD ---------- */
MissionScreen {
    background: #050505;
    layout: vertical;
    layers: base finale;
}

MissionHeader {
    height: 1;
    padding: 0 1;
    background: #14110b;
}

.mh-title {
    width: 1fr;
    color: #ffa028;
    text-style: bold;
}

.mh-clock {
    width: auto;
    color: #8a5a19;
    padding-right: 2;
}

.mh-lamp {
    width: auto;
    color: #35c759;
    text-style: bold;
}

.mh-lamp.-paused {
    color: #ff4a3d;
}

.mh-lamp.-replanning {
    color: #ffa028;
}

.mh-lamp.-passed {
    color: #35c759;
}

#mission-main {
    width: 100%;
    height: 1fr;
    layout: horizontal;
}

#mission-left {
    width: 3fr;
    height: 100%;
}

#mission-right {
    width: 2fr;
    height: 100%;
}

MissionPanel {
    height: auto;
    margin: 1 1 0 1;
    padding: 0 1;
    border: round #8a5a19;
    background: #0d0b08;
}

.panel-title {
    height: 1;
    color: #ffc25e;
    text-style: bold;
}

.panel-body {
    color: #ffd9a0;
    padding: 0 1 1 1;
}

DeviationAlert {
    border: heavy #ff4a3d;
    background: #160604;
}

DeviationAlert.-alert-on {
    background: #2a0a05;
}

DeviationAlert .panel-title {
    color: #ff4a3d;
}

ReplanStateMachine {
    height: auto;
    margin: 1 1 0 1;
    padding: 0 1 1 1;
    border: round #8a5a19;
    background: #0d0b08;
}

.sm-nodes {
    height: 3;
    margin-top: 1;
}

.sm-node {
    width: auto;
    height: 3;
    padding: 0 1;
    border: solid #8a5a19;
    color: #6b5a3a;
    content-align: center middle;
}

.sm-node.-done {
    border: solid #ffa028;
    color: #ffa028;
}

.sm-node.-active {
    border: heavy #ffa028;
    background: #1f1508;
    color: #ffc25e;
    text-style: bold;
}

.sm-link {
    width: auto;
    height: 3;
    padding: 1 1 0 1;
    color: #8a5a19;
}

.sm-note {
    height: 1;
    margin-top: 1;
    color: #ffd9a0;
}

CommsFeed {
    height: 1fr;
    margin: 1 1 0 1;
    padding: 0 1;
    border: round #8a5a19;
    background: #0d0b08;
}

.comms-lines {
    height: 1fr;
    padding: 0 1;
    color: #ffd9a0;
}

.comm-line {
    height: auto;
    color: #ffd9a0;
}

SystemVoice {
    height: 3;
    margin: 1 1 0 1;
    padding: 1 2 0 2;
    border-top: heavy #ffa028;
    background: #0d0b08;
    color: #ffc25e;
    text-style: bold;
}

#mission-hint {
    height: 1;
    padding: 0 2;
    color: #6b5a3a;
    content-align: right middle;
}

FinaleOverlay {
    layer: finale;
    width: 100%;
    height: 100%;
    background: #050505 96%;
    align: center middle;
}

FinaleOverlay Static {
    width: auto;
    content-align: center middle;
}

.finale-title {
    height: auto;
    padding: 1 4;
    border: heavy #ffa028;
    color: #ffa028;
    text-style: bold;
}

.finale-subtitle {
    padding-top: 1;
    color: #ffd9a0;
}

.finale-lines {
    padding-top: 1;
    color: #b07a2a;
}

.finale-footer {
    padding-top: 1;
    color: #6b5a3a;
}
